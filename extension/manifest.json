{
  "manifest_version": 3,
  "name": "omaCortex",
  "version": "0.3.1",
  "description": "Remembers the pages you read and watch by name, in omaCortex on this computer. Sends nothing over the network.",
  "key": "",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "permissions": ["tabs", "nativeMessaging", "idle", "alarms", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["meta.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "omaCortex",
    "default_popup": "popup.html"
  }
}
