[Unit]
Description=omaCortex activity recorder (local only)
Documentation=https://github.com/anonb3ll/omaCortex
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@OMACORTEX@ daemon
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
