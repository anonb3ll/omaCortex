#!/bin/sh
# omacortex launcher used by the shell plugin. Runs the recorder binary that
# install.sh built (target/release) or downloaded (libexec/), else one on PATH.
set -eu
self=$(readlink -f "$0")
root=$(dirname "$(dirname "$self")")
for candidate in "${OMACORTEX_BIN:-}" "$root/target/release/omacortex" "$root/libexec/omacortex"; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done
old_ifs=$IFS
IFS=:
for dir in $PATH; do
  candidate="$dir/omacortex"
  if [ -x "$candidate" ] && [ "$(readlink -f "$candidate")" != "$self" ]; then
    IFS=$old_ifs
    exec "$candidate" "$@"
  fi
done
echo "omacortex: the recorder is not installed yet; run $root/install.sh" >&2
exit 127
